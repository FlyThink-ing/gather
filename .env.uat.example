# 复制为 .env.uat 后填写。真实文件已被 gitignore，禁止提交。
UAT_BASE_URL=http://YOUR_UAT_HOST:PORT

# 系统角色账号
UAT_ADMIN_EMAIL=admin@example.com
UAT_ADMIN_PASSWORD=YOUR_PASSWORD_HERE
UAT_MANAGER_EMAIL=manager@example.com
UAT_MANAGER_PASSWORD=YOUR_PASSWORD_HERE
UAT_USER_EMAIL=user@example.com
UAT_USER_PASSWORD=YOUR_PASSWORD_HERE

# 权限加固矩阵账号；必须使用彼此独立、关系符合注释的现有测试账号
UAT_TEAM_LEAD_EMAIL=team-lead@example.com
UAT_TEAM_LEAD_PASSWORD=YOUR_PASSWORD_HERE
UAT_OTHER_TEAM_LEAD_EMAIL=other-team-lead@example.com
UAT_OTHER_TEAM_LEAD_PASSWORD=YOUR_PASSWORD_HERE
UAT_EMPTY_MANAGER_EMAIL=empty-manager@example.com
UAT_EMPTY_MANAGER_PASSWORD=YOUR_PASSWORD_HERE
UAT_TEAM_MEMBER_EMAIL=team-member@example.com
UAT_TEAM_MEMBER_PASSWORD=YOUR_PASSWORD_HERE
UAT_OUTSIDER_EMAIL=outsider@example.com
UAT_OUTSIDER_PASSWORD=YOUR_PASSWORD_HERE
UAT_CROSS_GROUP_OWNER_EMAIL=cross-group-owner@example.com
UAT_CROSS_GROUP_OWNER_PASSWORD=YOUR_PASSWORD_HERE

# 业务身份账号；允许与上面的系统角色账号相同
UAT_PROJECT_OWNER_EMAIL=owner@example.com
UAT_PROJECT_OWNER_PASSWORD=YOUR_PASSWORD_HERE
UAT_TEST_LEAD_EMAIL=test-lead@example.com
UAT_TEST_LEAD_PASSWORD=YOUR_PASSWORD_HERE
UAT_TEST_ENGINEER_EMAIL=tester@example.com
UAT_TEST_ENGINEER_PASSWORD=YOUR_PASSWORD_HERE
UAT_TEST_PARTICIPANT_EMAIL=test-participant@example.com
UAT_TEST_PARTICIPANT_PASSWORD=YOUR_PASSWORD_HERE
UAT_AUTOMATION_TESTER_EMAIL=automation@example.com
UAT_AUTOMATION_TESTER_PASSWORD=YOUR_PASSWORD_HERE

# 可选。用于唯一命名本轮会改变状态的数据；不填时自动生成时间戳。
UAT_RUN_ID=
